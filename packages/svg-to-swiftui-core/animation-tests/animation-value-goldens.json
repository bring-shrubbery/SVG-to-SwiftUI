      "additive": false,
      "accumulate": false,
      "clamp": "none",
      "expected": 20
    },
    {
      "name": "discrete-exact-boundary",
      "attributeName": "pathLength",
      "base": 9,
      "values": [0, 10, 20],
      "form": "values",
