    { "name": "opacity", "attributeName": "opacity", "source": ".5", "expected": "0.5" },
    { "name": "length", "attributeName": "cx", "source": "50%", "expected": "100" },
    { "name": "angle", "attributeName": "orient", "source": "3.141592653589793rad", "expected": "180deg" },
    {
      "name": "color",
      "attributeName": "stop-color",
      "source": "rgba(255 0 128 / 50%)",
      "expected": "rgba(255 0 128 / 0.5)"
    },
    { "name": "number-list", "attributeName": "values", "source": "1, 2 3", "expected": "1 2 3" },
    {
      "name": "length-list",
