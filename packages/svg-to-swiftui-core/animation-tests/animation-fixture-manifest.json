      "timeline": {
        "durationMicroseconds": 1000000,
        "framesPerSecond": 30,
        "sampleTimesMicroseconds": [0, 500000, 1000000]
      },
      "expectDistinctReferenceFrames": true
    },
    "benchmark-01-numeric-cx": {
      "mode": "comparison",
      "referenceBackend": "webkit",
      "width": 96,
      "height": 48,
      "expectedMode": "view",
